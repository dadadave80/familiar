# Familiar accepts testnet only. Copy to .env; never commit actual keys.
NEAR_NETWORK=testnet
# Verified public NEAR testnet RPC. Scripts also verify the returned chain ID.
NEAR_RPC_URL=https://rpc.testnet.near.org
# Generated project account ending in .testnet, not a mainnet payout address.
NEAR_ROOT=
# Project root account key. Generated by bun run setup:testnet; do not paste into logs.
ROOT_PRIVATE_KEY=
# Gas sponsor subaccount and its full-access testnet dev key.
RELAYER_ID=
RELAYER_PRIVATE_KEY=
# Bram subaccount; NPC_PRIVATE_KEY must be a set_quotes-only function-call key.
NPC_ID=
NPC_PRIVATE_KEY=
# Temporary Bram administrative key, used only by setup/funding scripts.
NPC_ADMIN_PRIVATE_KEY=
# Staking pool account, verified active before deployment. No mainnet pool.
STAKING_POOL=
# Local ports and allowed browser origins. Set exact production origin when hosting.
RELAYER_PORT=3037
NPC_PORT=3038
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5178,http://localhost:3000
# Optional NEAR AI dashboard key and exact model ID. Empty means scripted pricing.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# Vite public values only. NEVER put a private key in any VITE_ variable.
VITE_NEAR_ROOT=
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
VITE_RELAYER_URL=/api
VITE_NPC_URL=/npc-api
# Optional public Auth0 client ID with this app's origin registered. Empty uses
# the official shared testnet client, verified only at http://localhost:3000.
# Run `bun run --cwd web dev:auth` for that local callback; no private key here.
VITE_NEAR_AUTH_CLIENT_ID=
# Public demo endpoints for the secret-free judge command, once actually deployed.
PUBLIC_RELAYER_URL=
PUBLIC_DEMO_URL=
