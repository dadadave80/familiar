# Familiar accepts testnet only. Copy to .env; never commit actual keys.
NEAR_NETWORK=testnet
# Verified public NEAR testnet RPC. Scripts also verify the returned chain ID.
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Generated project account ending in .testnet, not a mainnet payout address.
NEAR_ROOT=
# Project root account key. Generated by bun run setup:testnet; do not paste into logs.
ROOT_PRIVATE_KEY=
# Gas sponsor subaccount and its full-access testnet dev key.
RELAYER_ID=
RELAYER_PRIVATE_KEY=
# Bram subaccount; NPC_PRIVATE_KEY must be a set_quotes-only function-call key.
NPC_ID=
NPC_PRIVATE_KEY=
# Temporary Bram administrative key, used only by setup/funding scripts.
NPC_ADMIN_PRIVATE_KEY=
# Staking pool account, verified active before deployment. No mainnet pool.
STAKING_POOL=
# Local relayer port and allowed browser origins. Set the exact production origin when hosting.
RELAYER_PORT=3037
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5178,http://localhost:3000
# Vite public values only. NEVER put a private key in any VITE_ variable.
VITE_NEAR_ROOT=
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
VITE_RELAYER_URL=/api
# Google account mode requires an explicit public client ID and exact approved origin.
# The official shared testnet client is restricted to http://localhost:3000.
# Set VITE_TIDEBOUND_AUTH_ORIGIN to that origin for local dev:auth; an empty ID disables setup.
VITE_NEAR_AUTH_CLIENT_ID=
# Public relayer endpoint for the secret-free judge command, once actually deployed.
PUBLIC_RELAYER_URL=
# Tidebound is opt-in ONLY after recovery/device and compatible-stack checks.
# These never enable mainnet. Leave false for the legacy deployed contracts.
TIDEBOUND_ENABLED=false
NEAR_AUTH_CLIENT_ID=
VITE_TIDEBOUND_ENABLED=false
VITE_TIDEBOUND_AUTH_ORIGIN=
# Explicit account provider; credentials never fall back to a different signer.
ACCOUNT_PROVIDER=near-auth
VITE_ACCOUNT_PROVIDER=near-auth
PRIVY_APP_ID=
PRIVY_APP_SECRET=
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=
# Separate full H1 HTTP entry; requires its exact compatible testnet tuple.
TIDEBOUND_HTTP_ENABLED=false
